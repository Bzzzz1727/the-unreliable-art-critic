# Google Gemini API Key for The Unreliable Art Critic
# Configure this in your Vercel Project Environment Variables as GEMINI_API_KEY
# or in .env.local / .env for local testing.
GEMINI_API_KEY=

# Model configuration (defaults to gemini-3.5-flash-lite on free tier)
GEMINI_MODEL=gemini-3.5-flash-lite
